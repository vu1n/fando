exec']\n100|     if cli_info['supports_skip_git']:\n101|         cmd.append('--skip-git-repo-check')\n102| \n103|     try:\n104|         # Pass prompt content via stdin - Codex reads from stdin when no prompt arg given\n105|         result = subprocess.run(\n106|             cmd,\n107|             input=full_prompt,\n108|             capture_output=True,\n109|             text=True,\n110|             timeout=timeout\n111|         )\n112| \n113|         # Check for errors\n114|         error = None\n115|         if result.returncode != 0:\n116|             error = f\"Codex exited with code {result.returncode}: {result.stderr}\"\n117| \n118|         return CodexResult(\n119|             stdout=result.stdout,\n120|             stderr=result.stderr,\n121|             exit_code=result.returncode,\n122|             error=error\n123|         )\n124| \n125|     except subprocess.TimeoutExpired:\n126|         return CodexResult(\n127|             stdout=\"\",\n128|             stderr=\"\",\n129|             exit_code=-1,\n130|             error=f\"ERROR: Codex timed out after {timeout}s\"\n131|         )\n132|     except FileNotFoundError:\n133|         return CodexResult(\n134|             stdout=\"\",\n135|             stderr=\"\",\n136|             exit_code=-1,\n137|             error=\"ERROR: 'codex' command not found. Is Codex CLI installed?\"\n138|         )\n139| \n140| \n141| def main() -> None:\n142|     \"\"\"CLI entry point.\"\"\"\n143|     import argparse\n144| \n145|     parser = argparse.ArgumentParser(\n146|         description='Call Codex to review a plan',\n147|         epilog='Plan content is read from stdin'\n148|     )\n149|     parser.add_argument(\n150|         'prompt',\n151|         nargs='?',\n152|         default='Review this plan for architecture, risks, and completeness.',\n153|         help='Review prompt/instructions'\n154|     )\n155|     parser.add_argument(\n156|         '--timeout',\n157|         type=int,\n158|         default=600,\n159|         help='Timeout in seconds (default: 600 / 10 minutes)'\n160|     )\n161|     parser.add_argument(\n162|         '--check-only',\n163|         action='store_true',\n164|         help='Only check Codex CLI availability, do not call'\n165|     )\n166| \n167|     args = parser.parse_args()\n168| \n169|     # Check-only mode for verification\n170|     if args.check_only:\n171|         info = verify_codex_cli()\n172|         if info['error']:\n173|             print(f\"Error: {info['error']}\", file=sys.stderr)\n174|             sys.exit(1)\n175|         print(f\"Codex CLI: {info['version']}\")\n176|         print(f\"Supports --skip-git-repo-check: {info['supports_skip_git']}\")\n177|         sys.exit(0)\n178| \n179|     # Read plan from stdin\n180|     plan = sys.stdin.read()\n181|     if not plan.strip():\n182|         print(\"Error: No plan content provided on stdin\", file=sys.stderr)\n183|         sys.exit(1)\n184| \n185|     # Call Codex\n186|     result = call_codex(args.prompt, plan, timeout=args.timeout)\n187| \n188|     if result.error:\n189|         print(f\"Error: {result.error}\", file=sys.stderr)\n190|         sys.exit(1)\n191| \n192|     # Output the response\n193|     print(result.stdout)\n194| \n195|     # Also output stderr if present (may contain useful info)\n196|     if result.stderr:\n197|         print(f\"\\n[stderr]: {result.stderr}\", file=sys.stderr)\n198| \n199| \n200| if __name__ == '__main__':\n201|     main()\n202| \n</file>\n\n<file path=\"fando-plan/scripts/codex_lm.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| codex_lm.py - DSPy LM adapter for OpenAI Codex CLI\n4| \n5| Wraps `codex exec` as a DSPy language model provider so DSPy Signatures\n6| can use Codex subscriptions without API keys at runtime.\n7| \n8| Usage:\n9|     import dspy\n10|     from codex_lm import CodexLM\n11| \n12|     lm = CodexLM()\n13|     dspy.configure(lm=lm)\n14| \"\"\"\n15| import subprocess\n16| import time\n17| from typing import Any\n18| \n19| from call_codex import verify_codex_cli\n20| \n21| try:\n22|     from dspy.clients.base_lm import BaseLM\n23| except ImportError:\n24|     raise ImportError(\"DSPy is required: uv pip install dspy>=2.6.0\")\n25| \n26| \n27| class CodexLM(BaseLM):\n28|     \"\"\"DSPy LM adapter that routes inference through `codex exec` subprocess.\"\"\"\n29| \n30|     def __init__(self, timeout: int = 600, **kwargs):\n31|         super().__init__(model=\"codex/exec\", model_type=\"chat\", **kwargs)\n32|         self.timeout = timeout\n33| \n34|         # Verify CLI availability at init time\n35|         cli_info = verify_codex_cli()\n36|         if cli_info[\"error\"]:\n37|             raise RuntimeError(f\"Codex CLI not available: {cli_info['error']}\")\n38|         self.cli_version = cli_info[\"version\"]\n39|         self.supports_skip_git = cli_info[\"supports_skip_git\"]\n40| \n41|     def _messages_to_prompt(self, messages: list[dict[str, Any]]) -> str:\n42|         \"\"\"Flatten DSPy chat messages into a single prompt string for codex exec.\n43| \n44|         DSPy sends messages as [{\"role\": \"system\", ...}, {\"role\": \"user\", ...}].\n45|         Codex exec reads a single prompt from stdin, so we concatenate them.\n46|         \"\"\"\n47|         parts = []\n48|         for msg in messages:\n49|             role = msg.get(\"role\", \"user\")\n50|             content = msg.get(\"content\", \"\")\n51|             if role == \"system\":\n52|                 parts.append(content)\n53|             elif role == \"user\":\n54|                 parts.append(content)\n55|             elif role == \"assistant\":\n56|                 # Include prior assistant turns for context\n57|                 parts.append(f\"[Previous response]\\n{content}\")\n58|         return \"\\n\\n\".join(parts)\n59| \n60|     def forward(\n61|         self,\n62|         prompt: str | None = None,\n63|         messages: list[dict[str, Any]] | None = None,\n64|         **kwargs,\n65|     ) -> list[dict[str, Any]]:\n66|         \"\"\"Execute a single LM call through codex exec.\n67| \n68|         Returns OpenAI-compatible response format that DSPy expects.\n69|         \"\"\"\n70|         # Build the text prompt from either raw prompt or messages\n71|         if messages:\n72|             text_prompt = self._messages_to_prompt(messages)\n73|         elif prompt:\n74|             text_prompt = prompt\n75|         else:\n76|             raise ValueError(\"Either prompt or messages must be provided\")\n77| \n78|         # Build subprocess command\n79|         cmd = [\"codex\", \"exec\"]\n80|         if self.supports_skip_git:\n81|             cmd.append(\"--skip-git-repo-check\")\n82| \n83|         # Call codex exec via subprocess\n84|         start = time.time()\n85|         try:\n86|             result = subprocess.run(\n87|                 cmd,\n88|                 input=text_prompt,\n89|                 capture_output=True,\n90|                 text=True,\n91|                 timeout=self.timeout,\n92|             )\n93|         except subprocess.TimeoutExpired:\n94|             raise RuntimeError(f\"Codex exec timed out after {self.timeout}s\")\n95|         except FileNotFoundError:\n96|             raise RuntimeError(\"codex command not found\")\n97| \n98|         duration = time.time() - start\n99| \n100|         if result.returncode != 0:\n101|             raise RuntimeError(\n102|                 f\"Codex exec failed (code {result.returncode}): {result.stderr}\"\n103|             )\n104| \n105|         output_text = result.stdout.strip()\n106| \n107|         # Return OpenAI chat-completion-compatible format\n108|         response = {\n109|             \"id\": f\"codex-{int(time.time())}\",\n110|             \"object\": \"chat.completion\",\n111|             \"created\": int(time.time()),\n112|             \"model\": \"codex/exec\",\n113|             \"choices\": [\n114|                 {\n115|                     \"index\": 0,\n116|                     \"message\": {\n117|                         \"role\": \"assistant\",\n118|                         \"content\": output_text,\n119|                     },\n120|                     \"finish_reason\": \"stop\",\n121|                 }\n122|             ],\n123|             \"usage\": {\n124|                 \"prompt_tokens\": len(text_prompt.split()),\n125|                 \"completion_tokens\": len(output_text.split()),\n126|                 \"total_tokens\": len(text_prompt.split()) + len(output_text.split()),\n127|             },\n128|         }\n129| \n130|         # Log the call for DSPy history\n131|         self.history.append(\n132|             {\n133|                 \"prompt\": prompt,\n134|                 \"messages\": messages,\n135|                 \"kwargs\": kwargs,\n136|                 \"response\": response,\n137|                 \"outputs\": [output_text],\n138|                 \"usage\": response[\"usage\"],\n139|                 \"cost\": 0.0,\n140|                 \"timestamp\": time.time(),\n141|                 \"duration\": duration,\n142|             }\n143|         )\n144| \n145|         return [output_text]\n146| \n147|     async def aforward(\n148|         self,\n149|         prompt: str | None = None,\n150|         messages: list[dict[str, Any]] | None = None,\n151|         **kwargs,\n152|     ) -> list[dict[str, Any]]:\n153|         \"\"\"Async variant - delegates to sync forward since codex exec is subprocess-based.\"\"\"\n154|         return self.forward(prompt=prompt, messages=messages, **kwargs)\n155| \n156| \n157| if __name__ == \"__main__\":\n158|     lm = CodexLM()\n159|     print(f\"CodexLM initialized: {lm.cli_version}\")\n160|     print(f\"Supports --skip-git-repo-check: {lm.supports_skip_git}\")\n161| \n</file>\n\n<file path=\"fando-plan/scripts/run_parallel_reviews.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| run_parallel_reviews.py - Run multiple reviewer profiles in parallel\n4| \n5| Usage:\n6|     echo \"$PLAN\" | python3 run_parallel_reviews.py security frontend api\n7|     python3 run_parallel_reviews.py --profiles=security,frontend < plan.md\n8| \n9| Output (JSON):\n10|     {\n11|         \"results\": {\n12|             \"security\": {\"output\": \"...\", \"findings\": {...}, \"error\": null},\n13|             \"frontend\": {\"output\": \"...\", \"findings\": {...}, \"error\": null}\n14|         },\n15|         \"summary\": {\n16|             \"total_high\": 2,\n17|             \"total_medium\": 3,\n18|             \"profiles_completed\": 2,\n19|             \"profiles_failed\": 0\n20|         }\n21|     }\n22| \"\"\"\n23| import json\n24| import sys\n25| import time\n26| from concurrent.futures import ThreadPoolExecutor, as_completed\n27| from dataclasses import dataclass, field\n28| from pathlib import Path\n29| from typing import Any, Optional\n30| \n31| # Import sibling modules\n32| from call_codex import call_codex, verify_codex_cli\n33| from parse_findings import parse_findings, ParseResult\n34| from detect_profiles import PROFILES, get_profile_prompt_path\n35| \n36| # DSPy backend - optional\n37| try:\n38|     from dspy_reviewers import (\n39|         DSPY_AVAILABLE,\n40|         run_dspy_review,\n41|         prediction_to_review_output,\n42|     )\n43| except ImportError:\n44|     DSPY_AVAILABLE = False\n45| \n46| \n47| # Focus context added to each reviewer prompt\n48| FOCUS_PREAMBLE = \"\"\"\n49| ## Your Role in This Review\n50| \n51| You are one of several specialist reviewers examining this plan. You have the FULL plan\n52| for context - this helps you understand WHY decisions were made and how your domain\n53| connects to others.\n54| \n55| **However**: Only flag issues in YOUR domain. Other specialists cover other areas.\n56| - Understand the full context and reasoning\n57| - But only raise findings for your area of expertise\n58| - If something in your domain depends on another domain's decision, note it but don't\n59|   flag the other domain's choice\n60| \n61| This focused approach prevents duplicate findings and lets each specialist go deep\n62| in their area.\n63| \n64| ---\n65| \n66| \"\"\"\n67| \n68| \n69| @dataclass\n70| class ReviewResult:\n71|     profile: str\n72|     output: str = \"\"\n73|     findings: Optional[ParseResult] = None\n74|     error: Optional[str] = None\n75|     duration_seconds: float = 0.0\n76| \n77| \n78| @dataclass\n79| class ParallelReviewResult:\n80|     results: dict[str, ReviewResult] = field(default_factory=dict)\n81|     total_high: int = 0\n82|     total_medium: int = 0\n83|     total_low: int = 0\n84|     total_nitpick: int = 0\n85|     profiles_completed: int = 0\n86|     profiles_failed: int = 0\n87|     has_outstanding_issues: bool = False\n88| \n89| \n90| def load_profile_prompt(profile_name: str) -> Optional[str]:\n91|     \"\"\"Load the prompt file for a given profile.\"\"\"\n92|     prompt_path = get_profile_prompt_path(profile_name)\n93| \n94|     if not prompt_path or not prompt_path.exists():\n95|         # Fallback: return None to trigger generic prompt\n96|         return None\n97| \n98|     return prompt_path.read_text()\n99| \n100| \n101| def run_single_review(\n102|     profile: str,\n103|     plan: str,\n104|     timeout: int = 600,\n105|     security_level: str = 'public',\n106| ) -> ReviewResult:\n107|     \"\"\"\n108|     Run a single reviewer profile against the plan.\n109| \n110|     Args:\n111|         profile: Profile name (e.g., 'security', 'frontend')\n112|         plan: The full plan content to review\n113|         timeout: Maximum seconds to wait for Codex response\n114|         security_level: Security level for severity calibration\n115| \n116|     Returns:\n117|         ReviewResult with output, parsed findings, and any errors\n118|     \"\"\"\n119|     result = ReviewResult(profile=profile)\n120|     start_time = time.time()\n121| \n122|     try:\n123|         # Load profile-specific prompt\n124|         prompt = load_profile_prompt(profile)\n125| \n126|         # Inject security level for security profile\n127|         if profile == 'security' and prompt:\n128|             prompt = f\"Security Level: {security_level}\\n\\n{prompt}\"\n129| \n130|         if not prompt:\n131|             # Use generic fallback if profile prompt not found\n132|             display_name = PROFILES.get(profile, {}).get('display_name', profile)\n133|             prompt = f\"\"\"You are a {display_name} reviewing an implementation plan.\n134| \n135| Review this plan focusing on your area of expertise. Identify issues that would cause problems during implementation.\n136| \n137| For each finding, assign a risk level:\n138| - **HIGH**: Critical issue that must be addressed before implementation\n139| - **MEDIUM**: Important consideration that should be addressed\n140| - **LOW**: Minor improvement, nice-to-have\n141| - **NITPICK**: Cosmetic or stylistic preference\n142| \n143| Format your response as:\n144| \n145| ## Findings\n146| - [HIGH/MEDIUM/LOW/NITPICK] Finding description...\n147| \n148| ## Summary\n149| X high, Y medium, Z low, W nitpick findings.\n150| If no issues: \"LGTM - no concerns in my domain\"\n151| \"\"\"\n152| \n153|         # Add focus preamble to help reviewer stay in lane\n154|         full_prompt = FOCUS_PREAMBLE + prompt\n155| \n156|         # Call Codex with full plan\n157|         codex_result = call_codex(full_prompt, plan, timeout=timeout)\n158| \n159|         if codex_result.error:\n160|             result.error = codex_result.error\n161|         else:\n162|             result.output = codex_result.stdout\n163| \n164|             # Parse findings from the response\n165|             parsed = parse_findings(codex_result.stdout)\n166|             result.findings = parsed\n167| \n168|     except Exception as e:\n169|         result.error = f\"Exception during review: {str(e)}\"\n170| \n171|     result.duration_seconds = time.time() - start_time\n172|     return result\n173| \n174| \n175| def run_parallel_reviews(\n176|     plan: str,\n177|     profiles: list[str],\n178|     max_workers: Optional[int] = None,\n179|     timeout: int = 600,\n180|     security_level: str = 'public'\n181| ) -> ParallelReviewResult:\n182|     \"\"\"\n183|     Run multiple reviewers in parallel on the same plan version.\n184| \n185|     Each reviewer gets the FULL plan for context understanding, but is\n186|     instructed to only flag issues in their specific domain.\n187| \n188|     Args:\n189|         plan: The plan content to review\n190|         profiles: List of profile names to run\n191|         max_workers: Maximum parallel workers (default: number of profiles)\n192|         timeout: Timeout per reviewer in seconds\n193|         security_level: Security level for severity calibration\n194| \n195|     Returns:\n196|         ParallelReviewResult with all results and aggregated counts\n197|     \"\"\"\n198|     result = ParallelReviewResult()\n199| \n200|     if not profiles:\n201|         return result\n202| \n203|     # Default to running all profiles in parallel\n204|     if max_workers is None:\n205|         max_workers = len(profiles)\n206| \n207|     with ThreadPoolExecutor(max_workers=max_workers) as executor:\n208|         # Submit all reviews\n209|         future_to_profile = {\n210|             executor.submit(run_single_review, profile, plan, timeout, security_level): profile\n211|             for profile in profiles\n212|         }\n213| \n214|         # Collect results as they complete\n215|         for future in as_completed(future_to_profile):\n216|             profile = future_to_profile[future]\n217| \n218|             try:\n219|                 review_result = future.result()\n220|                 result.results[profile] = review_result\n221| \n222|                 if review_result.error:\n223|                     result.profiles_failed += 1\n224|                 else:\n225|                     result.profiles_completed += 1\n226| \n227|                     # Aggregate findings\n228|                     if review_result.findings:\n229|                         result.total_high += review_result.findings.high\n230|                         result.total_medium += review_result.findings.medium\n231|                         result.total_low += review_result.findings.low\n232|                         result.total_nitpick += review_result.findings.nitpick\n233| \n234|             except Exception as e:\n235|                 result.results[profile] = ReviewResult(\n236|                     profile=profile,\n237|                     error=f\"Future execution error: {str(e)}\"\n238|                 )\n239|                 result.profiles_failed += 1\n240| \n241|     # Determine if there are outstanding issues\n242|     result.has_outstanding_issues = result.total_high > 0 or result.total_medium > 0\n243| \n244|     return result\n245| \n246| \n247| def run_parallel_reviews_dspy(\n248|     plan: str,\n249|     profiles: list[str],\n250|     security_level: str = 'public',\n251|     use_optimized: bool = True,\n252| ) -> ParallelReviewResult:\n253|     \"\"\"Run parallel reviews using DSPy backend.\n254| \n255|     Calls dspy_reviewers.run_dspy_review(), converts predictions to text,\n256|     then feeds through parse_findings() so the output type matches the\n257|     Codex backend exactly.\n258|     \"\"\"\n259|     result = ParallelReviewResult()\n260| \n261|     if not DSPY_AVAILABLE:\n262|         raise ImportError(\"DSPy backend requires: uv pip install -e '.[dspy]'\")\n263| \n264|     predictions = run_dspy_review(\n265|         plan=plan,\n266|         profiles=profiles,\n267|         security_level=security_level,\n268|         use_optimized=use_optimized,\n269|     )\n270| \n271|     for profile, prediction in predictions.items():\n272|         start_time = time.time()\n273|         review = ReviewResult(profile=profile)\n274| \n275|         try:\n276|             text_output = prediction_to_review_output(prediction)\n277|             review.output = text_output\n278|             review.findings = parse_findings(text_output)\n279|             result.profiles_completed += 1\n280| \n281|             if review.findings:\n282|                 result.total_high += review.findings.high\n283|                 result.total_medium += review.findings.medium\n284|                 result.total_low += review.findings.low\n285|                 result.total_nitpick += review.findings.nitpick\n286|         except Exception as e:\n287|             review.error = f\"DSPy review error: {e}\"\n288|             result.profiles_failed += 1\n289| \n290|         review.duration_seconds = time.time() - start_time\n291|         result.results[profile] = review\n292| \n293|     result.has_outstanding_issues = result.total_high > 0 or result.total_medium > 0\n294|     return result\n295| \n296| \n297| def format_results_for_display(result: ParallelReviewResult) -> str:\n298|     \"\"\"Format parallel review results for terminal display.\"\"\"\n299|     lines = []\n300| \n301|     for profile, review in result.results.items():\n302|         display_name = PROFILES.get(profile, {}).get('display_name', profile)\n303|         lines.append(f\"\\n{display_name}:\")\n304| \n305|         if review.error:\n306|             lines.append(f\"  Error: {review.error}\")\n307|             continue\n308| \n309|         if not review.findings or not review.findings.findings:\n310|             lines.append(\"  No issues found\")\n311|             continue\n312| \n313|         # Group findings by level\n314|         for finding in review.findings.findings:\n315|             lines.append(f\"  - [{finding.level}] {finding.text}\")\n316| \n317|     # Summary\n318|     lines.append(f\"\\n--- Summary ---\")\n319|     lines.append(f\"Total: {result.total_high} HIGH, {result.total_medium} MEDIUM, \"\n320|                  f\"{result.total_low} LOW, {result.total_nitpick} NITPICK\")\n321|     lines.append(f\"Profiles: {result.profiles_completed} completed, \"\n322|                  f\"{result.profiles_failed} failed\")\n323| \n324|     if result.has_outstanding_issues:\n325|         lines.append(\"\\nOutstanding issues require addressing\")\n326|     else:\n327|         lines.append(\"\\nAll specialists satisfied\")\n328| \n329|     return '\\n'.join(lines)\n330| \n331| \n332| def main():\n333|     \"\"\"CLI entry point.\"\"\"\n334|     import argparse\n335| \n336|     parser = argparse.ArgumentParser(\n337|         description='Run multiple reviewer profiles in parallel',\n338|         epilog='Plan content is read from stdin'\n339|     )\n340|     parser.add_argument(\n341|         'profiles',\n342|         nargs='*',\n343|         help='Profile names to run (e.g., security frontend api)'\n344|     )\n345|     parser.add_argument(\n346|         '--profiles',\n347|         dest='profiles_flag',\n348|         help='Comma-separated profile names (alternative to positional args)'\n349|     )\n350|     parser.add_argument(\n351|         '--timeout',\n352|         type=int,\n353|         default=600,\n354|         help='Timeout per reviewer in seconds (default: 600)'\n355|     )\n356|     parser.add_argument(\n357|         '--max-workers',\n358|         type=int,\n359|         help='Maximum parallel workers (default: number of profiles)'\n360|     )\n361|     parser.add_argument(\n362|         '--format',\n363|         choices=['json', 'text'],\n364|         default='json',\n365|         help='Output format (default: json)'\n366|     )\n367|     parser.add_argument(\n368|         '--check-only',\n369|         action='store_true',\n370|         help='Only verify Codex CLI is available'\n371|     )\n372|     parser.add_argument(\n373|         '--security-level',\n374|         default='public',\n375|         choices=['personal', 'internal', 'public', 'enterprise'],\n376|         help='Security level for severity calibration (default: public)'\n377|     )\n378|     parser.add_argument(\n379|         '--backend',\n380|         choices=['dspy', 'codex'],\n381|         default='dspy',\n382|         help='Review backend: dspy (structured Signatures) or codex (legacy markdown prompts). Default: dspy'\n383|     )\n384|     parser.add_argument(\n385|         '--no-optimized',\n386|         action='store_true',\n387|         help='Skip loading GEPA-optimized modules (DSPy backend only)'\n388|     )\n389| \n390|     args = parser.parse_args()\n391| \n392|     # Check-only mode\n393|     if args.check_only:\n394|         info = verify_codex_cli()\n395|         if info['error']:\n396|             print(f\"Error: {info['error']}\", file=sys.stderr)\n397|             sys.exit(1)\n398|         print(f\"Codex CLI ready: {info['version']}\")\n399|         sys.exit(0)\n400| \n401|     # Determine profiles\n402|     profiles = args.profiles or []\n403|     if args.profiles_flag:\n404|         profiles = [p.strip() for p in args.profiles_flag.split(',')]\n405| \n406|     if not profiles:\n407|         print(\"Error: No profiles specified\", file=sys.stderr)\n408|         print(\"Usage: echo '$PLAN' | python3 run_parallel_reviews.py security frontend api\",\n409|               file=sys.stderr)\n410|         sys.exit(1)\n411| \n412|     # Validate profiles\n413|     invalid = [p for p in profiles if p not in PROFILES]\n414|     if invalid:\n415|         print(f\"Warning: Unknown profiles will use generic prompt: {invalid}\",\n416|               file=sys.stderr)\n417| \n418|     # Read plan from stdin\n419|     plan = sys.stdin.read()\n420| \n421|     if not plan.strip():\n422|         print(\"Error: No plan content provided on stdin\", file=sys.stderr)\n423|         sys.exit(1)\n424| \n425|     # Select backend\n426|     backend = args.backend\n427|     if backend == 'dspy' and not DSPY_AVAILABLE:\n428|         print(\"DSPy not available, falling back to codex backend\", file=sys.stderr)\n429|         backend = 'codex'\n430| \n431|     # Run parallel reviews\n432|     if backend == 'dspy':\n433|         result = run_parallel_reviews_dspy(\n434|             plan=plan,\n435|             profiles=profiles,\n436|             security_level=args.security_level,\n437|             use_optimized=not args.no_optimized,\n438|         )\n439|     else:\n440|         result = run_parallel_reviews(\n441|             plan=plan,\n442|             profiles=profiles,\n443|             max_workers=args.max_workers,\n444|             timeout=args.timeout,\n445|             security_level=args.security_level,\n446|         )\n447| \n448|     # Output results\n449|     if args.format == 'json':\n450|         output = {\n451|             'results': {},\n452|             'summary': {\n453|                 'total_high': result.total_high,\n454|                 'total_medium': result.total_medium,\n455|                 'total_low': result.total_low,\n456|                 'total_nitpick': result.total_nitpick,\n457|                 'profiles_completed': result.profiles_completed,\n458|                 'profiles_failed': result.profiles_failed,\n459|                 'has_outstanding_issues': result.has_outstanding_issues\n460|             },\n461|         }\n462| \n463|         for profile, review in result.results.items():\n464|             output['results'][profile] = {\n465|                 'output': review.output,\n466|                 'findings': {\n467|                     'high': review.findings.high if review.findings else 0,\n468|                     'medium': review.findings.medium if review.findings else 0,\n469|                     'low': review.findings.low if review.findings else 0,\n470|                     'nitpick': review.findings.nitpick if review.findings else 0,\n471|                     'items': [\n472|                         {'level': f.level, 'text': f.text}\n473|                         for f in (review.findings.findings if review.findings else [])\n474|                     ]\n475|                 } if review.findings else None,\n476|                 'error': review.error,\n477|                 'duration_seconds': review.duration_seconds\n478|             }\n479| \n480|         print(json.dumps(output, indent=2))\n481| \n482|     else:  # text format\n483|         print(format_results_for_display(result))\n484| \n485|     # Exit with non-zero if there are outstanding issues\n486|     if result.has_outstanding_issues:\n487|         sys.exit(1)\n488|     sys.exit(0)\n489| \n490| \n491| if __name__ == '__main__':\n492|     main()\n493| \n</file>\n\n<file path=\"fando-verify/scripts/gather_implementation.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| gather_implementation.py - Collect implementation diff via git\n4| \n5| Usage:\n6|     python3 gather_implementation.py              # Diff against merge-base with main\n7|     python3 gather_implementation.py --ref=abc123 # Diff against specific commit\n8|     python3 gather_implementation.py --stat       # Show stats only\n9| \"\"\"\n10| import argparse\n11| import json\n12| import subprocess\n13| import sys\n14| from dataclasses import dataclass, field\n15| \n16| \n17| @dataclass\n18| class ImplementationDiff:\n19|     diff: str\n20|     base_ref: str\n21|     head_ref: str\n22|     files_changed: list[str] = field(default_factory=list)\n23|     additions: int = 0\n24|     deletions: int = 0\n25|     error: str | None = None\n26| \n27| \n28| def is_git_repo() -> bool:\n29|     \"\"\"Check if current directory is in a git repository.\"\"\"\n30|     result = subprocess.run(\n31|         ['git', 'rev-parse', '--git-dir'],\n32|         capture_output=True, text=True, timeout=30\n33|     )\n34|     return result.returncode == 0\n35| \n36| \n37| def get_current_ref() -> str | None:\n38|     \"\"\"Get current HEAD reference.\"\"\"\n39|     result = subprocess.run(\n40|         ['git', 'rev-parse', '--short', 'HEAD'],\n41|         capture_output=True, text=True, timeout=30\n42|     )\n43|     if result.returncode == 0:\n44|         return result.stdout.strip()\n45|     return None\n46| \n47| \n48| def get_merge_base(target: str = \"main\") -> str | None:\n49|     \"\"\"\n50|     Find merge base with target branch.\n51| \n52|     Tries multiple common branch names in order.\n53|     \"\"\"\n54|     branches_to_try = [target, \"master\", f\"origin/{target}\", \"origin/main\", \"origin/master\"]\n55| \n56|     for branch in branches_to_try:\n57|         result = subprocess.run(\n58|             ['git', 'merge-base', 'HEAD', branch],\n59|             capture_output=True, text=True, timeout=30\n60|         )\n61|         if result.returncode == 0:\n62|             return result.stdout.strip()\n63|     return None\n64| \n65| \n66| def get_diff_stats(ref: str) -> tuple[int, int]:\n67|     \"\"\"Get additions and deletions count.\"\"\"\n68|     result = subprocess.run(\n69|         ['git', 'diff', '--shortstat', ref],\n70|         capture_output=True, text=True, timeout=30\n71|     )\n72|     if result.returncode != 0:\n73|         return 0, 0\n74| \n75|     text = result.stdout.strip()\n76|     additions = 0\n77|     deletions = 0\n78| \n79|     # Parse \"X files changed, Y insertions(+), Z deletions(-)\"\n80|     import re\n81|     add_match = re.search(r'(\\d+) insertion', text)\n82|     del_match = re.search(r'(\\d+) deletion', text)\n83| \n84|     if add_match:\n85|         additions = int(add_match.group(1))\n86|     if del_match:\n87|         deletions = int(del_match.group(1))\n88| \n89|     return additions, deletions\n90| \n91| \n92| def gather_diff(ref: str = None, target_branch: str = \"main\") -> ImplementationDiff:\n93|     \"\"\"\n94|     Gather git diff for verification.\n95| \n96|     Args:\n97|         ref: Specific commit/ref to diff against. If None, uses merge-base with main.\n98|         target_branch: Branch to find merge-base with (default: main)\n99| \n100|     Returns:\n101|         ImplementationDiff with diff content, metadata, and any errors.\n102|     \"\"\"\n103|     if not is_git_repo():\n104|         return ImplementationDiff(\n105|             diff=\"\", base_ref=\"\", head_ref=\"\",\n106|             error=\"Not in a git repository. Run from within a git repo or specify --ref explicitly.\"\n107|         )\n108| \n109|     head_ref = get_current_ref() or \"HEAD\"\n110| \n111|     if ref is None:\n112|         ref = get_merge_base(target_branch)\n113|         if ref is None:\n114|             return ImplementationDiff(\n115|                 diff=\"\", base_ref=\"\", head_ref=head_ref,\n116|                 error=f\"Could not find base branch ({target_branch}/master). Specify --ref explicitly.\"\n117|             )\n118| \n119|     # Get list of changed files\n120|     files_result = subprocess.run(\n121|         ['git', 'diff', '--name-only', ref],\n122|         capture_output=True, text=True, timeout=30\n123|     )\n124|     files = files_result.stdout.strip().split('\\n') if files_result.stdout.strip() else []\n125| \n126|     # Get full diff\n127|     diff_result = subprocess.run(\n128|         ['git', 'diff', ref],\n129|         capture_output=True, text=True, timeout=30\n130|     )\n131| \n132|     if diff_result.returncode != 0:\n133|         return ImplementationDiff(\n134|             diff=\"\", base_ref=ref[:8], head_ref=head_ref,\n135|             files_changed=files,\n136|             error=f\"git diff failed: {diff_result.stderr}\"\n137|         )\n138| \n139|     # Get stats\n140|     additions, deletions = get_diff_stats(ref)\n141| \n142|     return ImplementationDiff(\n143|         diff=diff_result.stdout,\n144|         base_ref=ref[:8] if len(ref) > 8 else ref,\n145|         head_ref=head_ref,\n146|         files_changed=files,\n147|         additions=additions,\n148|         deletions=deletions\n149|     )\n150| \n151| \n152| def gather_working_tree_diff() -> ImplementationDiff:\n153|     \"\"\"\n154|     Gather diff of working tree (uncommitted changes).\n155| \n156|     Useful when there's no merge-base or user wants to verify uncommitted work.\n157|     \"\"\"\n158|     if not is_git_repo():\n159|         return ImplementationDiff(\n160|             diff=\"\", base_ref=\"\", head_ref=\"\",\n161|             error=\"Not in a git repository.\"\n162|         )\n163| \n164|     head_ref = get_current_ref() or \"HEAD\"\n165| \n166|     # Get staged + unstaged changes\n167|     files_result = subprocess.run(\n168|         ['git', 'diff', '--name-only', 'HEAD'],\n169|         capture_output=True, text=True, timeout=30\n170|     )\n171|     files = files_result.stdout.strip().split('\\n') if files_result.stdout.strip() else []\n172| \n173|     # Include untracked files\n174|     untracked_result = subprocess.run(\n175|         ['git', 'ls-files', '--others', '--exclude-standard'],\n176|         capture_output=True, text=True, timeout=30\n177|     )\n178|     if untracked_result.stdout.strip():\n179|         files.extend(untracked_result.stdout.strip().split('\\n'))\n180| \n181|     # Get diff\n182|     diff_result = subprocess.run(\n183|         ['git', 'diff', 'HEAD'],\n184|         capture_output=True, text=True, timeout=30\n185|     )\n186| \n187|     additions, deletions = get_diff_stats('HEAD')\n188| \n189|     return ImplementationDiff(\n190|         diff=diff_result.stdout,\n191|         base_ref=\"HEAD\",\n192|         head_ref=\"working-tree\",\n193|         files_changed=files,\n194|         additions=additions,\n195|         deletions=deletions\n196|     )\n197| \n198| \n199| def main():\n200|     \"\"\"CLI entry point.\"\"\"\n201|     parser = argparse.ArgumentParser(\n202|         description='Gather git diff for verification',\n203|         epilog='Default: diff against merge-base with main/master'\n204|     )\n205|     parser.add_argument(\n206|         '--ref',\n207|         help='Specific commit/ref to diff against'\n208|     )\n209|     parser.add_argument(\n210|         '--target',\n211|         default='main',\n212|         help='Target branch for merge-base (default: main)'\n213|     )\n214|     parser.add_argument(\n215|         '--working-tree',\n216|         action='store_true',\n217|         help='Diff working tree (uncommitted changes) against HEAD'\n218|     )\n219|     parser.add_argument(\n220|         '--stat',\n221|         action='store_true',\n222|         help='Show stats only, not full diff'\n223|     )\n224|     parser.add_argument(\n225|         '--format',\n226|         choices=['text', 'json'],\n227|         default='text',\n228|         help='Output format'\n229|     )\n230| \n231|     args = parser.parse_args()\n232| \n233|     if args.working_tree:\n234|         result = gather_working_tree_diff()\n235|     else:\n236|         result = gather_diff(args.ref, args.target)\n237| \n238|     if result.error:\n239|         if args.format == 'json':\n240|             print(json.dumps({'error': result.error}))\n241|         else:\n242|             print(f\"Error: {result.error}\", file=sys.stderr)\n243|         sys.exit(1)\n244| \n245|     if args.format == 'json':\n246|         output = {\n247|             'base_ref': result.base_ref,\n248|             'head_ref': result.head_ref,\n249|             'files_changed': result.files_changed,\n250|             'file_count': len(result.files_changed),\n251|             'additions': result.additions,\n252|             'deletions': result.deletions\n253|         }\n254|         if not args.stat:\n255|             output['diff'] = result.diff\n256|         print(json.dumps(output, indent=2))\n257|     else:\n258|         if args.stat:\n259|             print(f\"Base: {result.base_ref}\")\n260|             print(f\"Head: {result.head_ref}\")\n261|             print(f\"Files changed: {len(result.files_changed)}\")\n262|             print(f\"Additions: {result.additions}\")\n263|             print(f\"Deletions: {result.deletions}\")\n264|             if result.files_changed:\n265|                 print(\"\\nChanged files:\")\n266|                 for f in result.files_changed:\n267|                     print(f\"  {f}\")\n268|         else:\n269|             print(result.diff)\n270| \n271| \n272| if __name__ == '__main__':\n273|     main()\n274| \n</file>\n\n<file path=\"fando-verify/scripts/find_plan.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| find_plan.py - Auto-detect the plan to verify against\n4| \n5| Usage:\n6|     python3 find_plan.py                    # Auto-detect for current project\n7|     python3 find_plan.py --path=/path/to    # Use explicit path\n8|     python3 find_plan.py --project=my-api   # Find for specific project\n9|     python3 find_plan.py --list             # List available plans\n10| \"\"\"\n11| import argparse\n12| import json\n13| import logging\n14| import os\n15| import subprocess\n16| import sys\n17| from dataclasses import dataclass\n18| from pathlib import Path\n19| \n20| logger = logging.getLogger(__name__)\n21| \n22| \n23| @dataclass\n24| class PlanInfo:\n25|     path: str\n26|     project: str\n27|     modified: float\n28|     size: int\n29|     error: str | None = None\n30| \n31| \n32| def get_project_name() -> str:\n33|     \"\"\"Get project name from git remote or directory.\"\"\"\n34|     try:\n35|         result = subprocess.run(\n36|             ['git', 'remote', 'get-url', 'origin'],\n37|             capture_output=True, text=True, timeout=5\n38|         )\n39|         if result.returncode == 0:\n40|             url = result.stdout.strip()\n41|             # Handle both HTTPS and SSH URLs\n42|             # https://github.com/user/repo.git -> repo\n43|             # git@github.com:user/repo.git -> repo\n44|             name = url.removesuffix('.git').split('/')[-1].split(':')[-1]\n45|             return name\n46|     except (subprocess.TimeoutExpired, FileNotFoundError) as e:\n47|         logger.debug(f\"Could not get project name from git remote: {e}\")\n48|         pass\n49| \n50|     # Fall back to current directory name\n51|     return os.path.basename(os.getcwd()) or \"standalone\"\n52| \n53| \n54| def get_plan_reviews_dir() -> Path:\n55|     \"\"\"Get the base directory for plan reviews.\"\"\"\n56|     return Path.home() / \".claude\" / \"plan-reviews\"\n57| \n58| \n59| def find_latest_plan(project: str = None) -> PlanInfo | None:\n60|     \"\"\"\n61|     Find the most recent plan file for this project.\n62| \n63|     Args:\n64|         project: Project name. If None, auto-detect from git/directory.\n65| \n66|     Returns:\n67|         PlanInfo with path and metadata, or None if not found.\n68|     \"\"\"\n69|     project = project or get_project_name()\n70|     plan_dir = get_plan_reviews_dir() / project\n71| \n72|     if not plan_dir.exists():\n73|         return None\n74| \n75|     # Find most recent .md file (excluding -verify.md files)\n76|     plans = [\n77|         p for p in plan_dir.glob(\"*.md\")\n78|         if not p.name.endswith(\"-verify.md\")\n79|     ]\n80| \n81|     if not plans:\n82|         return None\n83| \n84|     # Sort by modification time, most recent first\n85|     plans.sort(key=lambda p: p.stat().st_mtime, reverse=True)\n86|     latest = plans[0]\n87|     stat = latest.stat()\n88| \n89|     return PlanInfo(\n90|         path=str(latest),\n91|         project=project,\n92|         modified=stat.st_mtime,\n93|         size=stat.st_size\n94|     )\n95| \n96| \n97| def list_plans(project: str = None) -> list[PlanInfo]:\n98|     \"\"\"\n99|     List all available plans for a project.\n100| \n101|     Args:\n102|         project: Project name. If None, list all projects.\n103| \n104|     Returns:\n105|         List of PlanInfo objects.\n106|     \"\"\"\n107|     base_dir = get_plan_reviews_dir()\n108|     plans = []\n109| \n110|     if project:\n111|         project_dirs = [base_dir / project] if (base_dir / project).exists() else []\n112|     else:\n113|         project_dirs = [d for d in base_dir.iterdir() if d.is_dir()]\n114| \n115|     for project_dir in project_dirs:\n116|         proj_name = project_dir.name\n117|         for plan_file in project_dir.glob(\"*.md\"):\n118|             if plan_file.name.endswith(\"-verify.md\"):\n119|                 continue\n120|             stat = plan_file.stat()\n121|             plans.append(PlanInfo(\n122|                 path=str(plan_file),\n123|                 project=proj_name,\n124|                 modified=stat.st_mtime,\n125|                 size=stat.st_size\n126|             ))\n127| \n128|     # Sort by modification time, most recent first\n129|     plans.sort(key=lambda p: p.modified, reverse=True)\n130|     return plans\n131| \n132| \n133| def find_plan(explicit_path: str = None, project: str = None) -> tuple[str | None, str]:\n134|     \"\"\"\n135|     Find plan content and source description.\n136| \n137|     Args:\n138|         explicit_path: Explicit path to plan file.\n139|         project: Project name for auto-detection.\n140| \n141|     Returns:\n142|         (plan_content, source_description) or (None, error_message)\n143|     \"\"\"\n144|     if explicit_path:\n145|         path = Path(explicit_path).expanduser()\n146|         if not path.exists():\n147|             return None, f\"Plan file not found: {explicit_path}\"\n148|         try:\n149|             content = path.read_text()\n150|             return content, f\"from {path}\"\n151|         except Exception as e:\n152|             return None, f\"Error reading {explicit_path}: {e}\"\n153| \n154|     info = find_latest_plan(project)\n155|     if info:\n156|         try:\n157|             content = Path(info.path).read_text()\n158|             return content, f\"from {info.path}\"\n159|         except Exception as e:\n160|             return None, f\"Error reading {info.path}: {e}\"\n161| \n162|     project_name = project or get_project_name()\n163|     return None, f\"No plan found for project '{project_name}' in {get_plan_reviews_dir()}\"\n164| \n165| \n166| def main():\n167|     \"\"\"CLI entry point.\"\"\"\n168|     parser = argparse.ArgumentParser(\n169|         description='Find plan file to verify against',\n170|         epilog='If no path specified, auto-detects based on project'\n171|     )\n172|     parser.add_argument(\n173|         '--path',\n174|         help='Explicit path to plan file'\n175|     )\n176|     parser.add_argument(\n177|         '--project',\n178|         help='Project name (default: auto-detect from git)'\n179|     )\n180|     parser.add_argument(\n181|         '--list',\n182|         action='store_true',\n183|         help='List available plans'\n184|     )\n185|     parser.add_argument(\n186|         '--format',\n187|         choices=['text', 'json'],\n188|         default='text',\n189|         help='Output format'\n190|     )\n191|     parser.add_argument(\n192|         '--content',\n193|         action='store_true',\n194|         help='Output plan content instead of just path'\n195|     )\n196| \n197|     args = parser.parse_args()\n198| \n199|     if args.list:\n200|         plans = list_plans(args.project)\n201|         if args.format == 'json':\n202|             print(json.dumps([{\n203|                 'path': p.path,\n204|                 'project': p.project,\n205|                 'modified': p.modified,\n206|                 'size': p.size\n207|             } for p in plans], indent=2))\n208|         else:\n209|             if not plans:\n210|                 print(\"No plans found.\")\n211|                 sys.exit(1)\n212|             print(f\"Found {len(plans)} plan(s):\\n\")\n213|             for p in plans:\n214|                 from datetime import datetime\n215|                 mtime = datetime.fromtimestamp(p.modified).strftime('%Y-%m-%d %H:%M')\n216|                 print(f\"  {p.project}: {Path(p.path).name}\")\n217|                 print(f\"    Path: {p.path}\")\n218|                 print(f\"    Modified: {mtime}\")\n219|                 print()\n220|         sys.exit(0)\n221| \n222|     content, source = find_plan(args.path, args.project)\n223| \n224|     if content is None:\n225|         if args.format == 'json':\n226|             print(json.dumps({'error': source}))\n227|         else:\n228|             print(f\"Error: {source}\", file=sys.stderr)\n229|         sys.exit(1)\n230| \n231|     if args.format == 'json':\n232|         output = {\n233|             'source': source,\n234|             'found': True\n235|         }\n236|         if args.content:\n237|             output['content'] = content\n238|         print(json.dumps(output, indent=2))\n239|     else:\n240|         if args.content:\n241|             print(f\"# Plan {source}\\n\")\n242|             print(content)\n243|         else:\n244|             print(f\"Found plan {source}\")\n245| \n246| \n247| if __name__ == '__main__':\n248|     main()\n249| \n</file>\n\n<file path=\"fando-plan/scripts/aggregate_findings.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| aggregate_findings.py - Merge and analyze findings from multiple reviewers\n4| \n5| Usage:\n6|     python3 aggregate_findings.py < parallel_review_results.json\n7|     cat results.json | python3 aggregate_findings.py --detect-conflicts\n8| \n9| Output (JSON):\n10|     {\n11|         \"by_reviewer\": {...},\n12|         \"all_findings\": [...],\n13|         \"conflicts\": [...],\n14|         \"summary\": {...}\n15|     }\n16| \"\"\"\n17| import json\n18| import re\n19| import sys\n20| from dataclasses import dataclass, field\n21| from difflib import SequenceMatcher\n22| from typing import Optional\n23| \n24| \n25| @dataclass\n26| class Finding:\n27|     level: str\n28|     text: str\n29|     source: str  # which reviewer\n30| \n31| \n32| @dataclass\n33| class Conflict:\n34|     finding_a: Finding\n35|     finding_b: Finding\n36|     description: str\n37|     resolution_hint: Optional[str] = None\n38| \n39| \n40| @dataclass\n41| class AggregatedResult:\n42|     by_reviewer: dict[str, list[Finding]] = field(default_factory=dict)\n43|     all_findings: list[Finding] = field(default_factory=list)\n44|     conflicts: list[Conflict] = field(default_factory=list)\n45|     duplicates_removed: int = 0\n46|     total_high: int = 0\n47|     total_medium: int = 0\n48|     total_low: int = 0\n49|     total_nitpick: int = 0\n50|     has_outstanding_issues: bool = False\n51| \n52| \n53| # Common conflict patterns to detect\n54| CONFLICT_PATTERNS = [\n55|     {\n56|         'name': 'rate_limit_conflict',\n57|         'keywords_a': ['rate limit', 'throttle', 'restrict', 'limit requests'],\n58|         'keywords_b': ['throughput', 'performance', 'scale', 'high volume'],\n59|         'description': 'Rate limiting vs. throughput requirements',\n60|         'hint': 'Consider tiered rate limits: strict for public APIs, relaxed for authenticated users'\n61|     },\n62|     {\n63|         'name': 'client_vs_server_validation',\n64|         'keywords_a': ['client-side validation', 'frontend validation', 'ui validation'],\n65|         'keywords_b': ['server-side validation', 'backend validation', 'never trust client'],\n66|         'description': 'Client-side vs. server-side validation approach',\n67|         'hint': 'Both: client-side for UX, server-side for security'\n68|     },\n69|     {\n70|         'name': 'caching_vs_consistency',\n71|         'keywords_a': ['cache', 'caching', 'cache aggressively'],\n72|         'keywords_b': ['consistency', 'real-time', 'up-to-date', 'stale data'],\n73|         'description': 'Caching strategy vs. data consistency',\n74|         'hint': 'Use cache invalidation strategies, consider TTL based on data sensitivity'\n75|     },\n76|     {\n77|         'name': 'simplicity_vs_security',\n78|         'keywords_a': ['simple', 'straightforward', 'minimal'],\n79|         'keywords_b': ['security', 'secure', 'protection', 'defense in depth'],\n80|         'description': 'Implementation simplicity vs. security requirements',\n81|         'hint': 'Security is non-negotiable; simplify within security constraints'\n82|     },\n83|     {\n84|         'name': 'deploy_vs_migration',\n85|         'keywords_a': ['simple deploy', 'quick deploy', 'fast rollout'],\n86|         'keywords_b': ['migration', 'data migration', 'schema change', 'backwards compatible'],\n87|         'description': 'Deployment simplicity vs. migration complexity',\n88|         'hint': 'Phased approach: deploy code first, migrate data incrementally'\n89|     }\n90| ]\n91| \n92| \n93| def normalize_text(text: str) -> str:\n94|     \"\"\"Normalize text for comparison.\"\"\"\n95|     return re.sub(r'\\s+', ' ', text.lower().strip())\n96| \n97| \n98| def text_similarity(a: str, b: str) -> float:\n99|     \"\"\"Calculate similarity ratio between two texts.\"\"\"\n100|     return SequenceMatcher(None, normalize_text(a), normalize_text(b)).ratio()\n101| \n102| \n103| def is_duplicate(finding_a: Finding, finding_b: Finding, threshold: float = 0.7) -> bool:\n104|     \"\"\"Check if two findings are duplicates based on text similarity.\"\"\"\n105|     if finding_a.level != finding_b.level:\n106|         return False\n107|     return text_similarity(finding_a.text, finding_b.text) >= threshold\n108| \n109| \n110| def detect_conflict(finding_a: Finding, finding_b: Finding) -> Optional[Conflict]:\n111|     \"\"\"\n112|     Check if two findings represent a conflict.\n113| \n114|     Conflicts occur when reviewers from different domains have opposing recommendations.\n115|     \"\"\"\n116|     # Only check findings from different reviewers\n117|     if finding_a.source == finding_b.source:\n118|         return None\n119| \n120|     text_a = normalize_text(finding_a.text)\n121|     text_b = normalize_text(finding_b.text)\n122| \n123|     for pattern in CONFLICT_PATTERNS:\n124|         # Check if finding_a matches keywords_a and finding_b matches keywords_b\n125|         a_matches_a = any(kw in text_a for kw in pattern['keywords_a'])\n126|         b_matches_b = any(kw in text_b for kw in pattern['keywords_b'])\n127| \n128|         a_matches_b = any(kw in text_a for kw in pattern['keywords_b'])\n129|         b_matches_a = any(kw in text_b for kw in pattern['keywords_a'])\n130| \n131|         if (a_matches_a and b_matches_b) or (a_matches_b and b_matches_a):\n132|             return Conflict(\n133|                 finding_a=finding_a,\n134|                 finding_b=finding_b,\n135|                 description=pattern['description'],\n136|                 resolution_hint=pattern['hint']\n137|             )\n138| \n139|     return None\n140| \n141| \n142| def aggregate_findings(results: dict) -> AggregatedResult:\n143|     \"\"\"\n144|     Aggregate findings from parallel review results.\n145| \n146|     Args:\n147|         results: Dictionary from run_parallel_reviews.py output\n148| \n149|     Returns:\n150|         AggregatedResult with merged findings, conflicts detected, and summaries\n151|     \"\"\"\n152|     aggregated = AggregatedResult()\n153| \n154|     # Handle both raw results dict and wrapped format\n155|     if 'results' in results:\n156|         review_results = results['results']\n157|     else:\n158|         review_results = results\n159| \n160|     # Extract findings from each reviewer\n161|     for profile, data in review_results.items():\n162|         if data is None:\n163|             continue\n164| \n165|         findings_data = data.get('findings')\n166|         if not findings_data:\n167|             continue\n168| \n169|         profile_findings = []\n170|         items = findings_data.get('items', [])\n171| \n172|         for item in items:\n173|             finding = Finding(\n174|                 level=item.get('level', 'UNKNOWN'),\n175|                 text=item.get('text', ''),\n176|                 source=profile\n177|             )\n178|             profile_findings.append(finding)\n179|             aggregated.all_findings.append(finding)\n180| \n181|             # Count by level\n182|             level = finding.level.upper()\n183|             if level == 'HIGH':\n184|                 aggregated.total_high += 1\n185|             elif level == 'MEDIUM':\n186|                 aggregated.total_medium += 1\n187|             elif level == 'LOW':\n188|                 aggregated.total_low += 1\n189|             elif level == 'NITPICK':\n190|                 aggregated.total_nitpick += 1\n191| \n192|         aggregated.by_reviewer[profile] = profile_findings\n193| \n194|     # Detect duplicates and remove them from all_findings\n195|     unique_findings = []\n196|     for finding in aggregated.all_findings:\n197|         is_dupe = False\n198|         for existing in unique_findings:\n199|             if is_duplicate(finding, existing):\n200|                 is_dupe = True\n201|                 aggregated.duplicates_removed += 1\n202|                 break\n203|         if not is_dupe:\n204|             unique_findings.append(finding)\n205| \n206|     # Note: we keep all_findings as-is but track duplicates_removed count\n207| \n208|     # Detect conflicts between findings from different reviewers\n209|     high_medium_findings = [\n210|         f for f in aggregated.all_findings\n211|         if f.level in ('HIGH', 'MEDIUM')\n212|     ]\n213| \n214|     for i, finding_a in enumerate(high_medium_findings):\n215|         for finding_b in high_medium_findings[i+1:]:\n216|             conflict = detect_conflict(finding_a, finding_b)\n217|             if conflict:\n218|                 aggregated.conflicts.append(conflict)\n219| \n220|     # Set outstanding issues flag\n221|     aggregated.has_outstanding_issues = (\n222|         aggregated.total_high > 0 or aggregated.total_medium > 0\n223|     )\n224| \n225|     return aggregated\n226| \n227| \n228| def format_for_display(result: AggregatedResult) -> str:\n229|     \"\"\"Format aggregated results for terminal display.\"\"\"\n230|     lines = []\n231| \n232|     # Findings by reviewer\n233|     lines.append(\"━━━ Findings by Reviewer ━━━\")\n234|     for reviewer, findings in result.by_reviewer.items():\n235|         lines.append(f\"\\n{reviewer.title()}:\")\n236|         if not findings:\n237|             lines.append(\"  ✓ No issues\")\n238|         else:\n239|             for f in findings:\n240|                 lines.append(f\"  - [{f.level}] {f.text}\")\n241| \n242|     # Conflicts\n243|     if result.conflicts:\n244|         lines.append(\"\\n━━━ Potential Conflicts Detected ━━━\")\n245|         for conflict in result.conflicts:\n246|             lines.append(f\"\\n⚠️  {conflict.description}\")\n247|             lines.append(f\"   {conflict.finding_a.source}: {conflict.finding_a.text[:80]}...\")\n248|             lines.append(f\"   {conflict.finding_b.source}: {conflict.finding_b.text[:80]}...\")\n249|             if conflict.resolution_hint:\n250|                 lines.append(f\"   💡 Suggestion: {conflict.resolution_hint}\")\n251| \n252|     # Summary\n253|     lines.append(\"\\n━━━ Summary ━━━\")\n254|     lines.append(f\"Total: {result.total_high} HIGH, {result.total_medium} MEDIUM, \"\n255|                  f\"{result.total_low} LOW, {result.total_nitpick} NITPICK\")\n256|     lines.append(f\"Reviewers: {len(result.by_reviewer)}\")\n257|     lines.append(f\"Duplicates removed: {result.duplicates_removed}\")\n258|     lines.append(f\"Conflicts detected: {len(result.conflicts)}\")\n259| \n260|     if result.has_outstanding_issues:\n261|         lines.append(\"\\n⚠️  Outstanding HIGH/MEDIUM issues require addressing\")\n262|     else:\n263|         lines.append(\"\\n✓ No outstanding issues\")\n264| \n265|     return '\\n'.join(lines)\n266| \n267| \n268| def main():\n269|     \"\"\"CLI entry point.\"\"\"\n270|     import argparse\n271| \n272|     parser = argparse.ArgumentParser(\n273|         description='Aggregate findings from multiple reviewers',\n274|         epilog='Parallel review results (JSON) are read from stdin'\n275|     )\n276|     parser.add_argument(\n277|         '--format',\n278|         choices=['json', 'text'],\n279|         default='json',\n280|         help='Output format (default: json)'\n281|     )\n282|     parser.add_argument(\n283|         '--detect-conflicts',\n284|         action='store_true',\n285|         help='Enable conflict detection (default: enabled)'\n286|     )\n287|     parser.add_argument(\n288|         '--show-duplicates',\n289|         action='store_true',\n290|         help='Show duplicate findings that were detected'\n291|     )\n292| \n293|     args = parser.parse_args()\n294| \n295|     # Read results from stdin\n296|     try:\n297|         input_data = sys.stdin.read()\n298|         if not input_data.strip():\n299|             print(\"Error: No input provided on stdin\", file=sys.stderr)\n300|             sys.exit(1)\n301|         results = json.loads(input_data)\n302|     except json.JSONDecodeError as e:\n303|         print(f\"Error: Invalid JSON input: {e}\", file=sys.stderr)\n304|         sys.exit(1)\n305| \n306|     # Aggregate findings\n307|     aggregated = aggregate_findings(results)\n308| \n309|     # Output\n310|     if args.format == 'json':\n311|         output = {\n312|             'by_reviewer': {\n313|                 reviewer: [\n314|                     {'level': f.level, 'text': f.text, 'source': f.source}\n315|                     for f in findings\n316|                 ]\n317|                 for reviewer, findings in aggregated.by_reviewer.items()\n318|             },\n319|             'all_findings': [\n320|                 {'level': f.level, 'text': f.text, 'source': f.source}\n321|                 for f in aggregated.all_findings\n322|             ],\n323|             'conflicts': [\n324|                 {\n325|                     'finding_a': {\n326|                         'level': c.finding_a.level,\n327|                         'text': c.finding_a.text,\n328|                         'source': c.finding_a.source\n329|                     },\n330|                     'finding_b': {\n331|                         'level': c.finding_b.level,\n332|                         'text': c.finding_b.text,\n333|                         'source': c.finding_b.source\n334|                     },\n335|                     'description': c.description,\n336|                     'resolution_hint': c.resolution_hint\n337|                 }\n338|                 for c in aggregated.conflicts\n339|             ],\n340|             'summary': {\n341|                 'total_high': aggregated.total_high,\n342|                 'total_medium': aggregated.total_medium,\n343|                 'total_low': aggregated.total_low,\n344|                 'total_nitpick': aggregated.total_nitpick,\n345|                 'duplicates_removed': aggregated.duplicates_removed,\n346|                 'conflicts_detected': len(aggregated.conflicts),\n347|                 'has_outstanding_issues': aggregated.has_outstanding_issues\n348|             }\n349|         }\n350|         print(json.dumps(output, indent=2))\n351|     else:\n352|         print(format_for_display(aggregated))\n353| \n354|     # Exit with non-zero if outstanding issues\n355|     if aggregated.has_outstanding_issues:\n356|         sys.exit(1)\n357|     sys.exit(0)\n358| \n359| \n360| if __name__ == '__main__':\n361|     main()\n362| \n</file>\n\n<file path=\"fando-plan/scripts/detect_profiles.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| detect_profiles.py - Detect relevant reviewer profiles based on plan content\n4| \n5| Usage:\n6|     echo \"$PLAN\" | python3 detect_profiles.py\n7|     python3 detect_profiles.py < plan.md\n8| \n9| Output (JSON):\n10|     {\n11|         \"profiles\": [\"security\", \"frontend\", \"api\"],\n12|         \"detected_keywords\": {\n13|             \"security\": [\"auth\", \"jwt\", \"token\"],\n14|             \"frontend\": [\"react\", \"component\"],\n15|             \"api\": [\"endpoint\", \"REST\"]\n16|         },\n17|         \"summary\": \"Detected: authentication, React UI, REST endpoints\"\n18|     }\n19| \"\"\"\n20| import json\n21| import re\n22| import sys\n23| from dataclasses import dataclass, field\n24| from pathlib import Path\n25| from typing import Optional\n26| \n27| \n28| # Profile definitions with keywords and prompt file locations\n29| PROFILES = {\n30|     'security': {\n31|         'keywords': [\n32|             'auth', 'password', 'token', 'jwt', 'encrypt', 'secret',\n33|             'permission', 'role', 'cors', 'sanitize', 'xss', 'csrf',\n34|             'oauth', 'session', 'login', 'credential', 'rbac', 'acl',\n35|             'hash', 'salt', 'bcrypt', 'argon', 'ssl', 'tls', 'https',\n36|             'certificate', 'firewall', 'vulnerability', 'injection',\n37|             'authentication', 'authorization', 'security', 'secure'\n38|         ],\n39|         'prompt_file': 'profiles/security.md',\n40|         'display_name': 'Security Reviewer',\n41|         'description': 'authentication, authorization, input validation'\n42|     },\n43|     'frontend': {\n44|         'keywords': [\n45|             'react', 'vue', 'angular', 'svelte', 'component', 'css', 'ui', 'ux',\n46|             'form', 'modal', 'page', 'render', 'state', 'redux', 'hook', 'hooks',\n47|             'tailwind', 'styled', 'responsive', 'accessibility', 'a11y',\n48|             'frontend', 'front-end', 'browser', 'dom', 'jsx', 'tsx',\n49|             'nextjs', 'next.js', 'nuxt', 'gatsby', 'remix', 'button',\n50|             'dropdown', 'navigation', 'sidebar', 'dashboard', 'layout'\n\n170| \n171| def get_profile_prompt_path(profile_name: str) -> Optional[Path]:\n172|     \"\"\"Get the absolute path to a profile's prompt file.\"\"\"\n173|     config = PROFILES.get(profile_name)\n174|     if not config:\n175|         return None\n176| \n177|     # Get the references directory relative to this script\n178|     script_dir = Path(__file__).parent\n179|     references_dir = script_dir.parent / 'references'\n180| \n181|     return references_dir / config['prompt_file']\n182| \n183| \n184| def list_all_profiles() -> dict:\n185|     \"\"\"Return information about all available profiles.\"\"\"\n</file>\n\n<file path=\"fando-plan/scripts/backfill_training.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| backfill_training.py - Backfill training data from existing plan review logs\n4| \n5| Parses structured review logs from ~/.claude/plan-reviews/ and creates\n6| training examples for DSPy reviewer optimization.\n7| \n8| Usage:\n9|     python3 backfill_training.py                    # Backfill all\n10|     python3 backfill_training.py --dry-run          # Preview without writing\n11|     python3 backfill_training.py --stats            # Show results after\n12| \"\"\"\n13| import argparse\n14| import re\n15| import sys\n16| from pathlib import Path\n17| \n18| PLAN_REVIEWS_DIR = Path(\"~/.claude/plan-reviews\").expanduser()\n19| \n20| \n21| def classify_domain(text: str) -> str:\n22|     \"\"\"Classify finding text into a domain using PROFILES keyword lists.\n23| \n24|     Counts keyword matches per domain. Highest wins, fallback to 'architect'.\n25|     \"\"\"\n26|     text_lower = text.lower()\n27|     scores: dict[str, int] = {}\n28| \n29|     for domain, config in PROFILES.items():\n30|         count = 0\n\n40|     return max(scores, key=scores.get)\n41| \n42| \n43| def parse_zellij_bridge(path: Path) -> list[ReviewExample]:\n44|     \"\"\"Parse willo/zellij-bridge-phase2.md into training examples.\n45| \n46|     Structure: ### Iteration N: Title, then **SEVERITY (count):** blocks\n47|     with bullet findings, then **Resolution:** line.\n48|     \"\"\"\n49|     text = path.read_text()\n50|     plan_context = text  # Use full log as plan context\n51| \n52|     examples = []\n53|     # Split on iteration headers\n54|     iterations = re.split(r\"(?=### Iteration \\d+:)\", text)\n55| \n56|     for block in iterations:\n57|         m = re.match(r\"### Iteration (\\d+):\", block)\n58|         if not m:\n59|             continue\n60|         iteration = int(m.group(1))\n\n100| \n101|         # All findings were acted on (each iteration has Resolution confirming)\n102|         example = ReviewExample(\n103|             plan=plan_context,\n104|             domain=domain,\n105|             other_domains=[],\n106|             security_level=\"internal\",\n107|             review_output=review_output,\n108|             findings_acted_on=[f for _, f in findings],\n109|             findings_ignored=[],\n110|             missed_issues=[],\n111|             stayed_in_lane=True,\n112|             severity_gold=severity_counts,\n113|             plan_id=\"zellij-bridge-phase2\",\n114|             iteration=iteration,\n115|         )\n116|         examples.append(example)\n117| \n118|     return examples\n119| \n120| \n\n150|     for version in sorted(version_findings):\n151|         findings = version_findings[version]\n152| \n153|         # Build review output\n154|         review_lines = []\n155|         severity_counts: dict[str, int] = {}\n156|         finding_texts = []\n157| \n158|         for sev, title, fix in findings:\n159|             review_lines.append(f\"- [{sev}] {title}\")\n160|             severity_counts[sev] = severity_counts.get(sev, 0) + 1\n161|             finding_texts.append(title)\n162| \n163|         review_output = \"\\n\".join(review_lines)\n164| \n165|         # Classify domain from finding content\n166|         all_text = \" \".join(f\"{title} {fix}\" for _, title, fix in findings)\n167|         domain = classify_domain(all_text)\n168| \n169|         # Determine other domains present in this plan\n170|         other_domains = []\n\n195|             plan_id=\"jj-workspace-migration\",\n196|             iteration=version,\n197|         )\n198|         examples.append(example)\n199| \n200|     return examples\n201| \n202| \n203| def main():\n204|     # Add parent scripts dir for imports (only when run as script)\n205|     sys.path.insert(0, str(Path(__file__).parent))\n206| \n207|     from detect_profiles import PROFILES\n208|     from dspy_reviewers import ReviewExample, save_training_example, load_training_examples\n209| \n210|     parser = argparse.ArgumentParser(\n\n220| \n221|     all_examples: list[\"ReviewExample\"] = []\n222| \n223|     # Parse zellij-bridge-phase2\n224|     zellij_path = PLAN_REVIEWS_DIR / \"willo\" / \"2026-01-19-zellij-bridge-phase2.md\"\n225|     if zellij_path.exists():\n226|         examples = parse_zellij_bridge(zellij_path)\n227|         print(f\"Parsed {zellij_path.name}: {len(examples)} examples\")\n228|         for ex in examples:\n229|             sev = ex.severity_gold\n230|             print(\n231|                 f\"  Iteration {ex.iteration}: {len(ex.findings_acted_on)} findings \"\n232|                 f\"({sev}) → domain={ex.domain}\"\n233|             )\n234|         all_examples.extend(examples)\n235|     else:\n236|         print(f\"Not found: {zellij_path}\")\n237| \n238|     # Parse jj-workspace-migration\n239|     jj_path = PLAN_REVIEWS_DIR / \"bacchus\" / \"2026-01-20-jj-workspace-migration.md\"\n240|     if jj_path.exists():\n\n250|     else:\n251|         print(f\"Not found: {jj_path}\")\n252| \n253|     print(f\"\\nTotal: {len(all_examples)} examples\")\n254| \n255|     if args.dry_run:\n256|         print(\"\\n[DRY RUN] No files written.\")\n257|         return\n258| \n259|     # Write examples\n260|     written = 0\n261|     for ex in all_examples:\n262|         path = save_training_example(ex)\n263|         print(f\"  Saved: {path.name}\")\n264|         written += 1\n265| \n266|     print(f\"\\nWrote {written} training examples\")\n267| \n268|     if args.stats:\n269|         print(\"\\n--- Training Data Stats ---\")\n270|         examples = load_training_examples()\n</file>\n\n<file path=\"fando-plan/scripts/optimize.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| optimize.py - GEPA optimization CLI for fando-plan reviewers\n4| \n5| Optimizes DSPy reviewer Signatures using labeled training data and a\n6| reflection model. Requires an API key only for the GEPA reflection LM\n7| (one-time optimization cost).\n8| \n9| Usage:\n10|     # Show training data statistics\n11|     python3 optimize.py --stats\n12| \n13|     # Optimize a single domain\n14|     python3 optimize.py --domain security --reflection-model openai/gpt-4o --auto light\n15| \n16|     # Optimize all domains with training data\n17|     python3 optimize.py --all --reflection-model openai/gpt-4o --auto light\n18| \n19|     # Export optimized instructions to markdown for inspection\n20|     python3 optimize.py --export\n21| \n22| Training data location: ~/.claude/skills/fando-plan/training_data/*.json\n23| Optimized modules:      ~/.claude/skills/fando-plan/optimized/{domain}.json\n24| \"\"\"\n25| import argparse\n26| import json\n27| import sys\n28| from pathlib import Path\n29| from typing import Any, Optional\n30| \n\n100|     auto: str = \"light\",\n101|     val_split: float = 0.2,\n102| ) -> Optional[Any]:\n103|     \"\"\"Run GEPA optimization for a single domain.\n104| \n105|     Args:\n106|         domain: Domain name (e.g. \"security\")\n107|         reflection_model: Model for GEPA reflection (e.g. \"openai/gpt-4o\")\n108|         auto: Budget preset (\"light\", \"medium\", \"heavy\")\n109|         val_split: Fraction of data for validation\n110|     \"\"\"\n111|     print(f\"\\n--- Optimizing: {domain} ---\")\n112| \n113|     examples = load_training_examples(domain=domain)\n114|     if len(examples) < 5:\n115|         print(f\"  Not enough training data ({len(examples)} examples, need at least 5)\")\n116|         return None\n117| \n118|     # Split into train/val\n119|     split_idx = max(1, int(len(examples) * (1 - val_split)))\n120|     trainset = examples[:split_idx]\n\n140|         metric=review_metric,\n141|         reflection_lm=dspy.LM(model=reflection_model),\n142|         auto=auto,\n143|     )\n144| \n145|     # Run optimization\n146|     print(\"  Running GEPA optimization...\")\n147|     optimized = gepa.compile(\n148|         student=module,\n149|         trainset=dspy_trainset,\n150|         valset=dspy_valset,\n151|     )\n152| \n153|     # Save\n154|     path = save_optimized_module(domain, optimized)\n155|     print(f\"  Saved optimized module: {path}\")\n156| \n157|     # Evaluate on validation set\n158|     print(\"  Evaluating on validation set...\")\n159|     total_score = 0.0\n160|     for ex in valset:\n\n175| \n176| def export_optimized() -> None:\n177|     \"\"\"Export optimized instructions to markdown for human inspection.\"\"\"\n178|     if not OPTIMIZED_DIR.exists():\n179|         print(\"No optimized modules found.\")\n180|         print(f\"  Expected location: {OPTIMIZED_DIR}\")\n181|         return\n182| \n183|     export_dir = Path(\"~/.claude/skills/fando-plan/exported_prompts\").expanduser()\n184|     export_dir.mkdir(parents=True, exist_ok=True)\n185| \n186|     for json_file in sorted(OPTIMIZED_DIR.glob(\"*.json\")):\n187|         domain = json_file.stem\n188|         print(f\"  Exporting {domain}...\")\n189| \n190|         try:\n191|             data = json.loads(json_file.read_text())\n192|         except (json.JSONDecodeError, OSError) as e:\n193|             print(f\"    Error reading {json_file}: {e}\")\n194|             continue\n195| \n\n205|         md_path.write_text(\"\\n\".join(lines))\n206|         print(f\"    Written to {md_path}\")\n207| \n208|     print(f\"\\nAll exports in: {export_dir}\")\n209| \n210| \n211| def _extract_instructions(obj: dict, lines: list[str], depth: int):\n212|     \"\"\"Recursively extract instruction-like fields from saved module state.\"\"\"\n213|     for key, value in obj.items():\n214|         if isinstance(value, str) and len(value) > 50:\n215|             lines.append(f\"\\n{'#' * (depth + 2)} {key}\\n\")\n216|             lines.append(value)\n217|         elif isinstance(value, dict):\n218|             lines.append(f\"\\n{'#' * (depth + 2)} {key}\\n\")\n219|             _extract_instructions(value, lines, depth + 1)\n220| \n\n235|         summary=\"\",\n236|     ).with_inputs(\"plan\", \"other_reviewers\", \"security_level\")\n237| \n238| \n239| def main() -> None:\n240|     parser = argparse.ArgumentParser(\n241|         description=\"GEPA optimization for fando-plan reviewers\",\n242|         formatter_class=argparse.RawDescriptionHelpFormatter,\n243|         epilog=\"\"\"\n244| Examples:\n245|   %(prog)s --stats                              Show training data counts\n246|   %(prog)s --domain security --auto light       Optimize security reviewer\n247|   %(prog)s --all --reflection-model openai/gpt-4o  Optimize all domains\n248|   %(prog)s --export                             Export optimized prompts to markdown\n249|         \"\"\",\n250|     )\n\n285|         help=\"Validation set fraction (default: 0.2)\",\n286|     )\n287| \n288|     args = parser.parse_args()\n289| \n290|     if args.stats:\n291|         show_stats()\n292|         return\n293| \n294|     if args.export:\n295|         export_optimized()\n296|         return\n297| \n298|     # Optimization mode\n299|     if args.domain:\n300|         optimize_domain(\n\n310|             if len(examples) >= 5:\n311|                 optimize_domain(\n312|                     domain=domain,\n313|                     reflection_model=args.reflection_model,\n314|                     auto=args.auto,\n315|                     val_split=args.val_split,\n316|                 )\n317|             else:\n318|                 print(f\"\\nSkipping {domain}: only {len(examples)} examples (need 5+)\")\n319| \n320| \n</file>\n\n<file path=\"fando-plan/scripts/detect_security_level.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| detect_security_level.py - Detect security level based on plan content\n4| \n5| Usage:\n6|     echo \"$PLAN\" | python3 detect_security_level.py\n7|     python3 detect_security_level.py < plan.md\n8| \n9| Output (JSON):\n10|     {\n11|         \"level\": \"internal\",\n12|         \"confidence\": 0.8,\n13|         \"matched_keywords\": [\"admin\", \"dashboard\", \"employee\"],\n14|         \"description\": \"Internal tool for authenticated employees\"\n15|     }\n16| \n17| Security Levels:\n18|     - personal: Side projects, learning, prototypes (minimal exposure)\n19|     - internal: Company internal tools, trusted users (authenticated employees)\n20|     - public: Public-facing apps, customer data (untrusted internet users)\n21|     - enterprise: Regulated industries, sensitive data (compliance, audit)\n22| \"\"\"\n23| import json\n24| import re\n25| import sys\n26| from dataclasses import dataclass, field\n27| from typing import Optional\n28| \n29| \n30| # Security level definitions with keywords and descriptions\n\n80|     all_matches: dict[str, list[str]] = field(default_factory=dict)\n81|     error: Optional[str] = None\n82| \n83| \n84| def detect_security_level(plan: str) -> DetectionResult:\n85|     \"\"\"\n86|     Analyze plan content and return detected security level with confidence.\n87| \n88|     Args:\n89|         plan: The plan text to analyze\n90| \n91|     Returns:\n92|         DetectionResult with detected level, confidence, and matched keywords\n93|     \"\"\"\n94|     result = DetectionResult()\n95| \n96|     if not plan or not plan.strip():\n97|         result.error = \"Empty plan\"\n98|         result.description = SECURITY_LEVELS[DEFAULT_LEVEL]['description']\n99|         return result\n100| \n\n125| \n126|     # Determine the best match\n127|     if not level_scores:\n128|         # No matches - use default with low confidence\n129|         result.level = DEFAULT_LEVEL\n130|         result.confidence = 0.3\n131|         result.description = SECURITY_LEVELS[DEFAULT_LEVEL]['description']\n132|         return result\n133| \n134|     # Find level with most matches\n135|     best_level = max(level_scores, key=lambda k: len(level_scores[k]))\n136|     best_matches = level_scores[best_level]\n137| \n138|     # Calculate confidence based on:\n139|     # - Number of matches (more = higher confidence)\n140|     # - Whether there are competing levels (ambiguity reduces confidence)\n141|     match_count = len(best_matches)\n142|     total_levels_matched = len(level_scores)\n143| \n144|     # Base confidence from match count\n145|     if match_count >= 5:\n\n165|             if second_count >= best_count - 1:\n166|                 # Close competition - reduce confidence\n167|                 base_confidence *= 0.8\n168| \n169|     result.level = best_level\n170|     result.confidence = round(base_confidence, 2)\n171|     result.matched_keywords = best_matches\n172|     result.description = SECURITY_LEVELS[best_level]['description']\n173| \n174|     return result\n175| \n\n190|     }\n191| \n192| \n193| def main():\n194|     \"\"\"CLI entry point.\"\"\"\n195|     import argparse\n196| \n197|     parser = argparse.ArgumentParser(\n198|         description='Detect security level for a plan',\n199|         epilog='Plan content is read from stdin'\n200|     )\n201|     parser.add_argument(\n202|         '--list-levels',\n203|         action='store_true',\n204|         help='List all available security levels and exit'\n205|     )\n206|     parser.add_argument(\n207|         '--format',\n208|         choices=['json', 'text'],\n209|         default='json',\n210|         help='Output format (default: json)'\n\n230|     if not plan.strip():\n231|         print(\"Error: No plan content provided on stdin\", file=sys.stderr)\n232|         sys.exit(1)\n233| \n234|     # Detect security level\n235|     result = detect_security_level(plan)\n236| \n237|     if result.error:\n238|         print(f\"Error: {result.error}\", file=sys.stderr)\n239|         sys.exit(1)\n240| \n241|     # Output based on format\n242|     if args.format == 'json':\n243|         output = {\n244|             'level': result.level,\n245|             'confidence': result.confidence,\n\n255|         print(f\"Security level: {result.level}\")\n256|         print(f\"Confidence: {result.confidence:.0%}\")\n257|         print(f\"Description: {result.description}\")\n258|         if resul