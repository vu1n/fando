se from Codex.\n39| \n40|     Expected format:\n41|     ## Verification Results\n42|     - [MATCH] Description\n43|     - [IMPROVEMENT] Description\n44|     - [REGRESSION] Description - needs attention\n45|     - [MISSING] Description\n46|     - [UNPLANNED] Description\n47| \n48|     ## Summary\n49|     X matches, Y improvements, Z regressions, W missing, V unplanned\n50|     \"\"\"\n51|     result = VerificationResult()\n52| \n53|     if not response.strip():\n54|         result.error = \"Empty response from Codex\"\n55|         return result\n56| \n57|     # Find verification results section\n58|     # Try multiple patterns to be flexible\n59|     verification_patterns = [\n60|         r'## Verification Results?\\s*\\n(.*?)(?=\\n## |\\Z)',\n61|         r'### Verification Results?\\s*\\n(.*?)(?=\\n### |\\n## |\\Z)',\n62|         r'\\*\\*Verification Results?\\*\\*\\s*\\n(.*?)(?=\\n\\*\\*|\\n## |\\Z)',\n63|     ]\n64| \n65|     text = None\n66|     for pattern in verification_patterns:\n67|         match = re.search(pattern, response, re.DOTALL | re.IGNORECASE)\n68|         if match:\n69|             text = match.group(1)\n70|             break\n71| \n72|     if not text:\n73|         # Try to find items anywhere in the response\n74|         text = response\n75| \n76|     # Parse items with [CATEGORY] markers\n77|     # Pattern matches: - [CATEGORY] description (possibly multiline until next item or section)\n78|     category_pattern = re.compile(\n79|         r'^[-*]\\s*\\[(MATCH|IMPROVEMENT|REGRESSION|MISSING|UNPLANNED)\\]\\s*(.+?)(?=^[-*]\\s*\\[|^##|^[-*]\\s*$|\\Z)',\n80|         re.MULTILINE | re.DOTALL | re.IGNORECASE\n81|     )\n82| \n83|     for match in category_pattern.finditer(text):\n84|         category = match.group(1).upper()\n85|         description = match.group(2).strip()\n86| \n87|         # Clean up description - remove trailing whitespace and newlines\n88|         description = re.sub(r'\\s+', ' ', description).strip()\n89| \n90|         item = VerificationItem(\n91|             category=category,\n92|             description=description\n93|         )\n94|         result.items.append(item)\n95| \n96|         if category == 'MATCH':\n97|             result.matches += 1\n98|         elif category == 'IMPROVEMENT':\n99|             result.improvements += 1\n100|         elif category == 'REGRESSION':\n101|             result.regressions += 1\n102|             result.attention_items.append(f\"[REGRESSION] {description}\")\n103|         elif category == 'MISSING':\n104|             result.missing += 1\n105|             result.attention_items.append(f\"[MISSING] {description}\")\n106|         elif category == 'UNPLANNED':\n107|             result.unplanned += 1\n108| \n109|     # Build summary\n110|     total = result.matches + result.improvements + result.regressions + result.missing + result.unplanned\n111| \n112|     if total == 0:\n113|         result.error = \"No verification items found in response\"\n114|         return result\n115| \n116|     result.summary = (\n117|         f\"{result.matches} matches, {result.improvements} improvements, \"\n118|         f\"{result.regressions} regressions, {result.missing} missing, \"\n119|         f\"{result.unplanned} unplanned\"\n120|     )\n121| \n122|     return result\n123| \n124| \n125| def format_result_text(result: VerificationResult) -> str:\n126|     \"\"\"Format verification result as readable text.\"\"\"\n127|     lines = []\n128| \n129|     if result.error:\n130|         lines.append(f\"Error: {result.error}\")\n131|         return '\\n'.join(lines)\n132| \n133|     lines.append(\"## Verification Results\\n\")\n134| \n135|     # Group by category\n136|     categories = ['MATCH', 'IMPROVEMENT', 'REGRESSION', 'MISSING', 'UNPLANNED']\n137| \n138|     for category in categories:\n139|         items = [i for i in result.items if i.category == category]\n140|         if items:\n141|             for item in items:\n142|                 marker = f\"[{item.category}]\"\n143|                 lines.append(f\"- {marker} {item.description}\")\n144| \n145|     lines.append(f\"\\n## Summary\\n{result.summary}\")\n146| \n147|     if result.attention_items:\n148|         lines.append(\"\\n## Attention Needed\\n\")\n149|         for item in result.attention_items:\n150|             lines.append(f\"- {item}\")\n151| \n152|     return '\\n'.join(lines)\n153| \n154| \n155| def main() -> None:\n156|     \"\"\"CLI entry point.\"\"\"\n157|     parser = argparse.ArgumentParser(\n158|         description='Parse Codex verification response',\n159|         epilog='Response is read from stdin'\n160|     )\n161|     parser.add_argument(\n162|         '--format',\n163|         choices=['text', 'json'],\n164|         default='text',\n165|         help='Output format'\n166|     )\n167|     parser.add_argument(\n168|         '--summary-only',\n169|         action='store_true',\n170|         help='Output summary line only'\n171|     )\n172| \n173|     args = parser.parse_args()\n174| \n175|     # Read response from stdin\n176|     response = sys.stdin.read()\n177| \n178|     if not response.strip():\n179|         print(\"Error: No response provided on stdin\", file=sys.stderr)\n180|         sys.exit(1)\n181| \n182|     result = parse_verification(response)\n183| \n184|     if result.error and not result.items:\n185|         if args.format == 'json':\n186|             print(json.dumps({'error': result.error}))\n187|         else:\n188|             print(f\"Error: {result.error}\", file=sys.stderr)\n189|         sys.exit(1)\n190| \n191|     if args.format == 'json':\n192|         output = {\n193|             'matches': result.matches,\n194|             'improvements': result.improvements,\n195|             'regressions': result.regressions,\n196|             'missing': result.missing,\n197|             'unplanned': result.unplanned,\n198|             'summary': result.summary,\n199|             'items': [\n200|                 {'category': i.category, 'description': i.description}\n201|                 for i in result.items\n202|             ],\n203|             'attention_items': result.attention_items,\n204|             'needs_attention': len(result.attention_items) > 0\n205|         }\n206|         if result.error:\n207|             output['warning'] = result.error\n208|         print(json.dumps(output, indent=2))\n209|     else:\n210|         if args.summary_only:\n211|             print(result.summary)\n212|         else:\n213|             print(format_result_text(result))\n214| \n215|     # Exit with code 1 if there are regressions or missing items\n216|     if result.regressions > 0 or result.missing > 0:\n217|         sys.exit(1)\n218| \n219| \n220| if __name__ == '__main__':\n221|     main()\n222| \n</file>\n\n<file path=\"fando-plan/scripts/parse_findings.py\">\n1| #!/usr/bin/env python3\n2| \"\"\"\n3| parse_findings.py - Parse Codex review response to extract findings\n4| \n5| Usage:\n6|     echo \"$CODEX_RESPONSE\" | python3 parse_findings.py\n7|     python3 parse_findings.py < response.txt\n8| \n9| Output (JSON):\n10|     {\n11|         \"high\": 1,\n12|         \"medium\": 2,\n13|         \"low\": 0,\n14|         \"nitpick\": 1,\n15|         \"lgtm\": false,\n16|         \"findings\": [\n17|             {\"level\": \"HIGH\", \"text\": \"Finding description...\"},\n18|             ...\n19|         ],\n20|         \"should_stop\": false,\n21|         \"stop_reason\": null\n22|     }\n23| \"\"\"\n24| import json\n25| import re\n26| import sys\n27| from dataclasses import dataclass, field, asdict\n28| from typing import Optional\n29| \n30| \n31| @dataclass\n32| class Finding:\n33|     level: str\n34|     text: str\n35| \n36| \n37| @dataclass\n38| class ParseResult:\n39|     high: int = 0\n40|     medium: int = 0\n41|     low: int = 0\n42|     nitpick: int = 0\n43|     lgtm: bool = False\n44|     findings: list[Finding] = field(default_factory=list)\n45|     should_stop: bool = False\n46|     stop_reason: Optional[str] = None\n47|     error: Optional[str] = None\n48|     raw: Optional[str] = None\n49| \n50| \n51| def parse_findings(response: str) -> ParseResult:\n52|     \"\"\"\n53|     Extract risk counts and findings from Codex response.\n54| \n55|     Uses delimiter-based parsing on the ## Findings section,\n56|     counting only lines that start with \"- [LEVEL]\" pattern.\n57|     \"\"\"\n58|     result = ParseResult()\n59| \n60|     if not response or not response.strip():\n61|         result.error = \"Empty response\"\n62|         result.raw = response\n63|         return result\n64| \n65|     # Check for LGTM\n66|     result.lgtm = bool(re.search(\n67|         r'LGTM.*(?:ready to implement|no further changes)',\n68|         response,\n69|         re.IGNORECASE\n70|     ))\n71| \n72|     # Look for findings section with clear markers\n73|     findings_match = re.search(\n74|         r'## Findings\\s*\\n(.*?)(?=\\n## |\\Z)',\n75|         response,\n76|         re.DOTALL\n77|     )\n78| \n79|     if not findings_match:\n80|         # No findings section - might be LGTM or malformed\n81|         if result.lgtm:\n82|             result.should_stop = True\n83|             result.stop_reason = \"LGTM - plan approved\"\n84|         else:\n85|             result.error = \"No findings section found\"\n86|             result.raw = response\n87|         return result\n88| \n89|     findings_text = findings_match.group(1)\n90| \n91|     # Parse individual findings with \"- [LEVEL]\" pattern\n92|     # This avoids false positives from text containing \"[HIGH]\" etc.\n93|     finding_pattern = re.compile(\n94|         r'^-\\s*\\[(HIGH|MEDIUM|LOW|NITPICK)\\]\\s*(.+?)(?=^-\\s*\\[|$)',\n95|         re.MULTILINE | re.DOTALL | re.IGNORECASE\n96|     )\n97| \n98|     for match in finding_pattern.finditer(findings_text):\n99|         level = match.group(1).upper()\n100|         text = match.group(2).strip()\n101| \n102|         result.findings.append(Finding(level=level, text=text))\n103| \n104|         if level == 'HIGH':\n105|             result.high += 1\n106|         elif level == 'MEDIUM':\n107|             result.medium += 1\n108|         elif level == 'LOW':\n109|             result.low += 1\n110|         elif level == 'NITPICK':\n111|             result.nitpick += 1\n112| \n113|     # Determine if we should stop\n114|     if result.lgtm or (result.high == 0 and result.medium == 0):\n115|         result.should_stop = True\n116|         if result.lgtm:\n117|             result.stop_reason = \"LGTM - plan approved\"\n118|         elif result.low == 0 and result.nitpick == 0:\n119|             result.stop_reason = \"No findings - plan approved\"\n120|         else:\n121|             result.stop_reason = \"Only LOW/NITPICK findings remain\"\n122| \n123|     return result\n124| \n125| \n126| def check_for_loops(current: ParseResult, history: list[ParseResult]) -> Optional[str]:\n127|     \"\"\"\n128|     Detect if Codex is looping on the same findings.\n129| \n130|     Returns a warning message if looping detected, None otherwise.\n131|     \"\"\"\n132|     if len(history) < 2:\n133|         return None\n134| \n135|     # Get current HIGH/MEDIUM finding texts\n136|     current_issues = {\n137|         f.text[:100] for f in current.findings\n138|         if f.level in ('HIGH', 'MEDIUM')\n139|     }\n140| \n141|     if not current_issues:\n142|         return None\n143| \n144|     # Check last 2 iterations for same issues\n145|     for prev in history[-2:]:\n146|         prev_issues = {\n147|             f.text[:100] for f in prev.findings\n148|             if f.level in ('HIGH', 'MEDIUM')\n149|         }\n150| \n151|         overlap = current_issues & prev_issues\n152|         if len(overlap) >= len(current_issues) * 0.7:  # 70% overlap\n153|             return f\"Codex appears to be repeating findings. {len(overlap)} issues unchanged.\"\n154| \n155|     return None\n156| \n157| \n158| def main():\n159|     \"\"\"CLI entry point.\"\"\"\n160|     import argparse\n161| \n162|     parser = argparse.ArgumentParser(\n163|         description='Parse Codex review findings',\n164|         epilog='Response is read from stdin'\n165|     )\n166|     parser.add_argument(\n167|         '--format',\n168|         choices=['json', 'summary', 'counts'],\n169|         default='json',\n170|         help='Output format (default: json)'\n171|     )\n172| \n173|     args = parser.parse_args()\n174| \n175|     # Read response from stdin\n176|     response = sys.stdin.read()\n177| \n178|     if not response.strip():\n179|         print(\"Error: No response provided on stdin\", file=sys.stderr)\n180|         sys.exit(1)\n181| \n182|     # Parse\n183|     result = parse_findings(response)\n184| \n185|     # Output based on format\n186|     if args.format == 'json':\n187|         # Convert to dict, handling dataclass fields\n188|         output = {\n189|             'high': result.high,\n190|             'medium': result.medium,\n191|             'low': result.low,\n192|             'nitpick': result.nitpick,\n193|             'lgtm': result.lgtm,\n194|             'findings': [{'level': f.level, 'text': f.text} for f in result.findings],\n195|             'should_stop': result.should_stop,\n196|             'stop_reason': result.stop_reason,\n197|             'error': result.error,\n198|         }\n199|         print(json.dumps(output, indent=2))\n200| \n201|     elif args.format == 'summary':\n202|         if result.error:\n203|             print(f\"Error: {result.error}\")\n204|         else:\n205|             print(f\"Findings: {result.high} HIGH, {result.medium} MEDIUM, \"\n206|                   f\"{result.low} LOW, {result.nitpick} NITPICK\")\n207|             if result.lgtm:\n208|                 print(\"Status: LGTM - ready to implement\")\n209|             elif result.should_stop:\n210|                 print(f\"Status: {result.stop_reason}\")\n211|             else:\n212|                 print(\"Status: Continue iterating\")\n213| \n214|     elif args.format == 'counts':\n215|         print(f\"{result.high} {result.medium} {result.low} {result.nitpick}\")\n216| \n217|     # Exit with non-zero if there was an error\n218|     if result.error:\n219|         sys.exit(1)\n220| \n221| \n222| if __name__ == '__main__':\n223|     main()\n224| \n</file>"
