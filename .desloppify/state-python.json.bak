    "review::.::holistic::error_consistency::dspy_exception_masked_as_no_findings::f0c8715a": {
      "id": "review::.::holistic::error_consistency::dspy_exception_masked_as_no_findings::f0c8715a",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "DSPy execution failures can be misclassified as successful zero-finding reviews.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "fando-plan/scripts/dspy_reviewers.py",
          "fando-plan/scripts/run_parallel_reviews.py",
          "fando-plan/scripts/parse_findings.py"
        ],
        "evidence": [
          "`prediction_to_review_output()` maps `Exception` to text (`## Findings` empty + `## Summary Error...`) instead of structured failure.",
          "`run_parallel_reviews_dspy()` parses that text and increments `profiles_completed` before any semantic error check.",
          "`parse_findings()` sets `should_stop=True` when HIGH/MEDIUM are zero, allowing failed reviewer runs to appear approval-equivalent."
        ],
        "suggestion": "Introduce a structured failure channel (`ReviewResult.error`) for prediction exceptions, skip findings parsing for failed predictions, and make `parse_findings` require explicit success markers before stop/approve decisions.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Fixed DSPy error handling: (1) Check if prediction is Exception BEFORE calling prediction_to_review_output(), set error and fail immediately. (2) Added explicit error marker 'DSPY_EXECUTION_FAILED' in error output. (3) Added check for empty findings with Error marker to detect failed predictions. (4) Only increment profiles_completed if there was no error. This prevents failed DSPy runs from appearing as successful zero-finding reviews.",
      "first_seen": "2026-02-28T07:10:08+00:00",
      "last_seen": "2026-02-28T07:10:08+00:00",
      "resolved_at": "2026-02-28T10:31:08+00:00",
      "reopen_count": 0,
      "lang": "python",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually modified run_parallel_reviews_dspy to check for Exception predictions before processing, added error detection logic, and updated prediction_to_review_output to use a more explicit error marker, so failed predictions are no longer counted as completed profiles, and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-28T10:31:08+00:00",
        "scan_verified": false
      }
    },
