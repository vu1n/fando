    "review::.::holistic::abstraction_fitness::dedup_pipeline_not_materialized::3f4737a1": {
      "id": "review::.::holistic::abstraction_fitness::dedup_pipeline_not_materialized::3f4737a1",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Aggregator computes a deduplicated set but publishes and scores raw duplicates.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "fando-plan/scripts/aggregate_findings.py",
          "fando-plan/scripts/run_parallel_reviews.py"
        ],
        "evidence": [
          "Dedup loop creates `unique_findings` and increments `duplicates_removed` but `all_findings` is explicitly left unchanged.",
          "Conflict detection and output serialization consume `aggregated.all_findings`, so duplicates still influence downstream interpretation and summary outputs."
        ],
        "suggestion": "Make dedup an explicit stage with selectable behavior: either replace `all_findings` with `unique_findings` for canonical outputs or expose separate fields (`all_findings_raw` and `all_findings_deduped`) and compute summaries from the chosen canonical list.",
        "reasoning": ""
      },
      "status": "fixed",
