    "review::.::holistic::error_consistency::codex_boundary_mixed_error_contracts::04a30797": {
      "id": "review::.::holistic::error_consistency::codex_boundary_mixed_error_contracts::04a30797",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Codex subprocess failures use conflicting contracts across shared call paths.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "fando-plan/scripts/call_codex.py",
          "fando-plan/scripts/codex_lm.py",
          "fando-plan/scripts/dspy_reviewers.py"
        ],
        "evidence": [
          "`call_codex.py` models failures as data (`CodexResult.error` and `(None, error)` tuple from `run_codex_subprocess`).",
          "`codex_lm.py` wraps the same subprocess classes (`TimeoutExpired`, `FileNotFoundError`, non-zero return code) as raised `RuntimeError` exceptions.",
          "`dspy_reviewers.run_dspy_review()` then catches broad exceptions and stores them as values, creating a third failure channel."
        ],
        "suggestion": "Define one shared error contract for Codex invocation (for example, a typed `CodexExecutionError` hierarchy or a single Result object), and update `call_codex`, `CodexLM`, and DSPy orchestration to propagate that contract unchanged.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-28T10:35:13+00:00",
      "last_seen": "2026-02-28T10:35:13+00:00",
      "resolved_at": "2026-02-28T10:48:54+00:00",
      "reopen_count": 0,
      "lang": "python",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::error_consistency::exception_to_text_smuggling::b9cfe75f": {
      "id": "review::.::holistic::error_consistency::exception_to_text_smuggling::b9cfe75f",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Reviewer execution exceptions are smuggled into normal review text output.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "fando-plan/scripts/dspy_reviewers.py",
          "fando-plan/scripts/collect_training.py",
          "fando-plan/scripts/backfill_training.py"
        ],
        "evidence": [
          "`run_dspy_review()` captures exceptions into `results[profile]` instead of failing fast or returning structured failure metadata.",
          "`prediction_to_review_output()` converts exceptions into a synthetic markdown payload (`Error: DSPY_EXECUTION_FAILED: ...`) in the summary block, not a typed error object.",
          "Training collection/backfill paths ingest review text as data, so this design can blend runtime failures with model content rather than enforcing an explicit failure boundary."
        ],
        "suggestion": "Return a structured per-profile status object (e.g., `{ok: bool, prediction, error_code, error_message}`) and make downstream collectors reject/branch on `ok == false` instead of parsing error text from markdown.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-28T10:35:13+00:00",
      "last_seen": "2026-02-28T10:35:13+00:00",
      "resolved_at": "2026-02-28T10:48:54+00:00",
      "reopen_count": 0,
      "lang": "python",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::error_consistency::cli_io_error_handling_gap::4001655a": {
      "id": "review::.::holistic::error_consistency::cli_io_error_handling_gap::4001655a",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "CLI scripts inconsistently handle file I/O failures at boundaries.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "fando-plan/scripts/collect_training.py",
          "fando-plan/scripts/backfill_training.py",
          "fando-verify/scripts/find_plan.py"
        ],
        "evidence": [
          "`collect_training.py` reads `plan_before`/`plan_after` with `read_text()` without handling `OSError`/decode failures, so failures escape as tracebacks.",
          "`backfill_training.py` parser helpers (`parse_zellij_bridge`, `parse_jj_workspace`) call `read_text()` without localized error translation.",
          "`find_plan.py` handles read failures explicitly and returns user-readable error messages, showing a different boundary policy for similar filesystem operations."
        ],
        "suggestion": "Add consistent boundary wrappers for file reads in the plan/training CLIs that catch `OSError` and decode errors, emit standardized error messages, and exit with predictable codes.",
